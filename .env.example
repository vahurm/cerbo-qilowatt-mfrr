# =============================================================================
# cerbo-qilowatt-mfrr — per-site configuration
# =============================================================================
# Copy this file to a private, UNTRACKED location (e.g. /data/qw-agent.env on
# the Cerbo) and fill in the real values. NEVER commit a filled-in .env.
#
#   cp .env.example /data/qw-agent.env   # then edit on the Cerbo
#
# All values are read by agent/qw_agent.py at startup.
# =============================================================================

# --- Qilowatt cloud (per-device, from Qilowatt support) ---------------------
# QW_DEVICE_ID is the MQTT TOPIC identity: telemetry is published to
# Q/<QW_DEVICE_ID>/SENSOR and commands arrive on Q/<QW_DEVICE_ID>/cmnd/backlog.
# In a qilowatt-ha install this is the config-entry field "inverter_id"
# (a UUID, e.g. 00000000-0000-0000-0000-000000000000), NOT the account-level
# "device_id" hex string.
# Using the wrong id silently breaks BOTH telemetry (empty dashboard) and
# command reception (mFRR signals never arrive).
QW_DEVICE_ID=REPLACE_WITH_INVERTER_ID
QW_MQTT_USER=REPLACE_WITH_MQTT_USER
QW_MQTT_PASS=REPLACE_WITH_MQTT_PASS
QW_MQTT_HOST=mqtt.qilowatt.it
QW_MQTT_PORT=8883
QW_MQTT_TLS=1

# --- Telemetry profile ------------------------------------------------------
# auto       = sum every PV source Venus knows about: /Dc/Pv/Power (MPPTs) +
#              /Ac/PvOnOutput (PV inverter on the Multi output) + /Ac/PvOnGrid
#              (PV inverter on the grid side). Fits any topology — leave it.
# dc_coupled / ac_coupled = the legacy per-topology names, still accepted.
QW_TELEMETRY_PROFILE=auto

# --- mFRR state machine + actuators -----------------------------------------
# Asymmetric power clamp, enforced twice:
#   import  = positive setpoint (frrdown, buy), export = |negative| (frrup, sell).
# qw_grid_setpoint.sh REJECTS a value outside these (leaving the previous
# setpoint in place); the agent CAPS the requested PowerLimit to them first, so
# a 27 kW request against a 15 kW cap still delivers 15 kW instead of nothing.
# The agent reads these from its environment too — keep them in this file.
QW_MAX_IMPORT_W=15000
QW_MAX_EXPORT_W=15000
# Actuator script paths (defaults match the standard /data install).
QW_DESS_TOGGLE_SCRIPT=/data/qw_dess_toggle.sh
QW_GRID_SETPOINT_SCRIPT=/data/qw_grid_setpoint.sh
# Two-level SOC floor: on this Venus build the Dynamic ESS delegate reads its
# floor from the SINGLE ESS min-SOC (CGwacs/BatteryLife/MinimumSocLimit ->
# /Control/ActiveSocLimit), NOT from DynamicEss/MinSoc, so arbitrage and mFRR
# share one floor. To let normal DESS arbitrage rest at X (the dashboard
# "Minimum SOC" slider) while an mFRR event may discharge deeper to Y (Y < X),
# set QW_MFRR_MIN_SOC=Y. qw_dess_toggle.sh then lowers the floor to Y for the
# event and restores X afterwards (atomic save/restore, same as DESS Mode).
# EMPTY = never touch the floor (single floor = the slider). Passed through to
# the toggle script via the agent's inherited environment.
#
# Y must be BELOW X or nothing happens: the script never raises the floor, so a
# Y above the slider logs "nothing to lower" and every event silently runs on the
# single arbitrage floor. Site B sat in exactly that state (X=15, Y=20).
# X itself stays the owner's at all times — the script only reads it, and `on`
# restores it only if the floor still holds the Y it installed, so changing the
# slider mid-event keeps the new value instead of having it reverted.
QW_MFRR_MIN_SOC=
# Qilowatt sources that count as an active mFRR event (comma-separated). A
# command is only actuated when ALL THREE hold: the source is listed here, the
# Mode is frrup/frrdown, and PowerLimit is non-zero. The mode and power gates
# are hardcoded in mfrr_statemachine.py.
#
# Which sources a site actually receives is decided cloud-side by its trader,
# and it is NOT the same everywhere — verify with tools/afrr_probe.py before
# assuming. Observed 2026-07: Site A is dispatched by "kratt" (KratTrade).
# Site B received only "qilowatt" until 2026-07-27, when Qilowatt
# support added a missing subscription and "kratt" dispatch began there too.
# Both also receive "qilowatt" commands with Mode=buy — see QW_TRADE_* below.
#
# Do NOT add "optimizer" here. It is Qilowatt's own cloud-side arbitrage
# scheduler, it writes the same WorkMode channel on 15-minute slot boundaries,
# and its Modes (limitexport/savebattery/normal) are not balancing dispatch.
# Listing it would hand the actuators to a second orchestrator.
QW_MFRR_SOURCES=fusebox,kratt,qilowatt
# Q trades — the vendor's SOC optimiser (the portal shows it as "Q" / BUY).
# `_source: qilowatt` with Mode=buy (PowerLimit 20-27 kW, BatterySoc=100) arrives
# 5-30 min after a kratt/frrup stand-down and is followed 5-30 min later by the
# next frrup: Qilowatt refills the battery between activations so the next
# up-regulation (paid ~1400 EUR/MWh) can be delivered. Measured on site A
# 2026-07-14..09-14: 7 in July, 14 in August, 18 in the first half of September.
# Dropping them leaves the battery at the mFRR floor and the next activation
# short or never dispatched.
#
# A trade is actuated exactly like dispatch (DESS off -> AcPowerSetPoint ->
# release), except that the SOC floor is NOT lowered and the event also ends
# when the live SOC reaches the commanded BatterySoc. Only buy/sell can ever be
# actuated; savebattery/limitexport/normal from any source are always dropped.
# Empty QW_TRADE_MODES = drop trades (the pre-2026-09 behaviour).
QW_TRADE_SOURCES=qilowatt
QW_TRADE_MODES=buy,sell
# Cap on a single trade (seconds). A 27 kW buy from the floor to 100 % on a
# 38 kWh pack takes ~1.3 h. Must stay BELOW qw_dess_watchdog.sh's QW_MAX_OFF_SECS.
QW_MAX_TRADE_S=5400
# Settle delay between DESS-off and the first setpoint write (seconds).
QW_DESS_OFF_DELAY_S=2
# Failsafes: revert if the QW link is lost this long while ACTIVE, or if a single
# event runs longer than this (seconds).
#
# Measure QW_MAX_EVENT_S against your own dispatch, do not guess: real events are
# far longer than they look. Over 179 site A events (2026-07) the median was
# 620 s, but 11 exceeded 1800 s and the longest ran 6292 s — at the old 1800 s
# cap the failsafe truncated 10 live events mid-delivery.
# Must stay BELOW qw_dess_watchdog.sh's QW_MAX_OFF_SECS (default 7800), which is
# the outer backstop.
QW_MQTT_LOST_FAILSAFE_S=300
QW_MAX_EVENT_S=7200
# Failsafe check interval (seconds).
QW_TICK_INTERVAL_S=10
# Liveness watchdog: if the QW cloud link stays down this long, the agent exits
# so the service supervisor restarts it. Recovers from a permanent qilowatt-py
# shutdown (e.g. after repeated auth failures) that a plain supervisor can't see
# because the process stays alive. 0 disables.
QW_LINK_RESTART_S=600
# Zombie-subscription watchdog: qilowatt-py keeps a session marked "connected"
# even when the WORKMODE re-subscribe fails, so telemetry keeps flowing while the
# agent goes permanently deaf to commands. If the transport is connected but the
# command topic stays unsubscribed this long, exit for a fresh restart. 0 disables.
QW_SUBSCRIBE_GRACE_S=120
# Backstop for silently deaf sessions that still report subscribed: if NO WORKMODE
# command is received for this long while the agent is IDLE, exit for a fresh QW
# subscription. A received command (incl. periodic NORMAL heartbeats) proves the
# subscription is live, so a site that keeps getting commands never restarts; only
# genuine command-silence triggers a refresh. An in-process reconnect can't restart
# qilowatt-py's telemetry timers, so a clean process restart is the only safe
# refresh. 0 disables.
#
# Size this from measured silence, and beware that too low a value HIDES the very
# data you need: the portal pushes a snapshot ~20 s after every (re)connect, so
# each refresh manufactures a command that resets the timer. Site B ran that loop
# for weeks — 49 of its 70 restarts were this watchdog, and its median gap came out
# as 21618 s, i.e. the 21600 s setting itself rather than anything about the market.
#
# Measured 2026-07 (tools/afrr_probe.py --log /data/afrr-workmode.log prints it):
#   site A   54.8 cmd/day, median gap 70 s,    longest silence 25.7 h
#   site B   6.5 cmd/day, median gap 21618 s, longest silence >= 31.9 h (masked)
# Re-measured on site A 2026-09-14 over 72.6 d at the 48 h setting: 3 silences
# of exactly 48.0 h and none longer — the same artefact again, one notch up.
# 96 h clears every measured gap; the previous 6 h default was below all of them.
# Site B's figure is a lower bound, since the loop truncated every gap it did
# not cause — it runs with 0 (disabled) while the real distribution is measured,
# and qw_log_audit.sh reports its silence instead of restarting it.
QW_IDLE_REFRESH_S=345600
# Initial-connect retry: Venus OS starts this service before the network is
# reliably up, so the first DNS resolve can fail ("Temporary failure in name
# resolution"). Site A crashed on that ~twice a day — harmless, since the
# supervisor restarts us, but it buried the log in tracebacks and dropped
# telemetry each time. Delay doubles per attempt, capped at 60 s; after the last
# attempt we exit and let the supervisor retry.
QW_CONNECT_ATTEMPTS=5
QW_CONNECT_RETRY_S=5
# Dry-run: log intended actions but DO NOT touch dbus (validation/parallel phase).
QW_DRY_RUN=0

# --- Telemetry --------------------------------------------------------------
# GridExportLimit reported to Qilowatt when MaxFeedInPower is unlimited (-1).
QW_GRID_EXPORT_LIMIT_W=15000
# How often (seconds) to refresh telemetry from dbus.
QW_TELEMETRY_INTERVAL_S=5

# --- Optional local MQTT bridge (Node-RED / dashboards) ---------------------
# The pure-Python path does NOT need this. Set to 1 only if a Node-RED flow or a
# dashboard should consume the decoded WORKMODE from a local broker. It also
# publishes the derived event state ("<prefix>/mfrr_active" on/off,
# "<prefix>/mfrr_kind" frr/trade/none, "<prefix>/mfrr_signed_w") so a Node-RED
# PV-curtailment flow can STAND DOWN (hold the inverter at 100%) while the agent
# owns the grid setpoint — otherwise the curtailment loop would fight an frr-up
# export / frr-down import. mfrr_active is on for Q trades as well.
QW_LOCAL_BRIDGE=0
LOCAL_MQTT_HOST=127.0.0.1
LOCAL_MQTT_PORT=1883
# Leave user/pass empty if the local broker allows anonymous localhost access.
LOCAL_MQTT_USER=
LOCAL_MQTT_PASS=
QW_LOCAL_PREFIX=qw

# --- Monitoring -------------------------------------------------------------
# The agent mirrors its state (IDLE/ACTIVE, kind, signed W, degraded flag,
# version) to this JSON file on every change — for qw_doctor.sh, dashboards or
# a Node-RED flow without a local MQTT broker. Empty = do not write it.
QW_STATE_FILE=/data/qw-agent/state.json
# Optional push notification for qw_log_audit.sh WARN/ERROR findings: any URL
# that accepts a text/plain POST (ntfy.sh topic, Slack/Discord/HA webhook).
# Sent with curl from the hourly audit loop; empty = off.
QW_ALERT_URL=

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
QW_LOG_LEVEL=INFO

# =============================================================================
# Example — site A (DC-coupled, asymmetric 28 kW import / 15 kW export):
#   QW_TELEMETRY_PROFILE=auto
#   QW_MAX_IMPORT_W=28000
#   QW_MAX_EXPORT_W=15000
#   QW_GRID_EXPORT_LIMIT_W=15000
#   QW_LOCAL_BRIDGE=0          # no Node-RED — pure Python state machine
# =============================================================================
